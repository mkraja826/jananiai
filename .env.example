JANANI_ENVIRONMENT=development
JANANI_FREE_FIRST_MODE=true
JANANI_ALLOW_REAL_PATIENT_DATA=false
JANANI_LLM_PROVIDER=mock
JANANI_LOG_LEVEL=INFO

# Development may use a fixed synthetic identity when authentication is disabled.
JANANI_AUTH_REQUIRED=false
JANANI_SYNTHETIC_USER_ID=00000000-0000-0000-0000-000000000001

# Configure these only for a dedicated synthetic staging Supabase project or branch.
JANANI_SUPABASE_URL=
JANANI_SUPABASE_PUBLISHABLE_KEY=
JANANI_SUPABASE_REQUEST_TIMEOUT_SECONDS=8

# Disabled by default. The service-role key belongs only in backend secret storage.
# Never expose it to the mobile app, browser bundle, logs, analytics, or source control.
JANANI_GOVERNANCE_ADMIN_API_ENABLED=false
JANANI_SUPABASE_SERVICE_ROLE_KEY=

# Phase 12 run-once reminder worker. Keep disabled unless a backend scheduler invokes it.
# This phase supports the deterministic mock transport only and remains blocked in production.
JANANI_REMINDER_WORKER_ENABLED=false
JANANI_REMINDER_WORKER_TRANSPORT=mock
JANANI_REMINDER_WORKER_BATCH_SIZE=50
JANANI_REMINDER_WORKER_MATERIALIZATION_LOOKBACK_MINUTES=15
JANANI_REMINDER_WORKER_MATERIALIZATION_HORIZON_MINUTES=1440
